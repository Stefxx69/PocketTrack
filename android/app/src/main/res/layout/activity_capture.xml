<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <android.opengl.GLSurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/crosshair"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/reticle" />

    <!-- Top left: back + tracking status -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnExit"
            style="@style/GlassIconButton"
            android:contentDescription="Back to library"
            app:icon="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/hud"
            style="@style/GlassPillText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Instructions (moved above the pad in vertical mode) -->
    <TextView
        android:id="@+id/hint"
        style="@style/GlassPillText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:maxWidth="320dp"
        android:textAlignment="center"
        android:textSize="14sp" />

    <!-- Top right: overlay toggles (stacked vertically in vertical mode) -->
    <LinearLayout
        android:id="@+id/toggleRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp">

        <Button
            android:id="@+id/btnPoints"
            style="@style/ToggleIconButton"
            android:contentDescription="Show tracked points"
            app:icon="@drawable/ic_points" />

        <Button
            android:id="@+id/btnMic"
            style="@style/ToggleIconButton"
            android:layout_marginStart="8dp"
            android:contentDescription="Record sound"
            app:icon="@drawable/ic_mic" />

        <Button
            android:id="@+id/btnDepth"
            style="@style/ToggleIconButton"
            android:layout_marginStart="8dp"
            android:contentDescription="Capture room depth"
            app:icon="@drawable/ic_depth" />

        <Button
            android:id="@+id/btnPlanes"
            style="@style/ToggleIconButton"
            android:layout_marginStart="8dp"
            android:contentDescription="Show detected floor"
            app:icon="@drawable/ic_grid" />

        <Button
            android:id="@+id/btnFloorLock"
            style="@style/ToggleIconButton"
            android:layout_marginStart="8dp"
            android:contentDescription="Floor lock: cube can't go through the floor"
            app:icon="@drawable/ic_lock" />
    </LinearLayout>

    <!-- Right: record + camera / cube options -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="6dp"
            android:background="@null"
            android:contentDescription="Record"
            android:src="@drawable/rec_button" />

        <Button
            android:id="@+id/btnQuality"
            style="@style/GlassChip"
            android:layout_marginTop="0dp"
            app:icon="@drawable/ic_hq" />

        <Button
            android:id="@+id/btnZoom"
            style="@style/GlassChip"
            app:icon="@drawable/ic_zoom" />

        <Button
            android:id="@+id/btnOrientation"
            style="@style/GlassChip"
            app:icon="@drawable/ic_landscape" />

        <Button
            android:id="@+id/btnSize"
            style="@style/GlassChip"
            android:text="Size"
            app:icon="@drawable/ic_size" />

        <Button
            android:id="@+id/btnReset"
            style="@style/GlassChip"
            android:text="Reset"
            app:icon="@drawable/ic_reset" />
    </LinearLayout>

    <!-- Zoom slider (shown by the zoom pill) -->
    <LinearLayout
        android:id="@+id/zoomPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="152dp"
        android:background="@drawable/bg_glass_bar"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="1×"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/zoomSlider"
            android:layout_width="200dp"
            android:layout_height="40dp"
            android:progressBackgroundTint="#55FFFFFF"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="3×"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom left: move the cube -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:gravity="bottom">

        <FrameLayout
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:background="@drawable/bg_dpad">

            <Button
                android:id="@+id/btnFwd"
                style="@style/PadIconButton"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="4dp"
                android:contentDescription="Move away"
                app:icon="@drawable/ic_chevron_up" />

            <Button
                android:id="@+id/btnBack"
                style="@style/PadIconButton"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="4dp"
                android:contentDescription="Move closer"
                app:icon="@drawable/ic_chevron_down" />

            <Button
                android:id="@+id/btnLeft"
                style="@style/PadIconButton"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="4dp"
                android:contentDescription="Move left"
                app:icon="@drawable/ic_chevron_left" />

            <Button
                android:id="@+id/btnRight"
                style="@style/PadIconButton"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:contentDescription="Move right"
                app:icon="@drawable/ic_chevron_right" />

            <Button
                android:id="@+id/btnPlace"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.06"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="PLACE"
                android:textColor="@color/on_accent"
                android:textSize="10sp"
                app:backgroundTint="@color/accent"
                app:cornerRadius="30dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_glass_bar"
            android:orientation="vertical"
            android:padding="4dp">

            <Button
                android:id="@+id/btnUp"
                style="@style/PadIconButton"
                android:contentDescription="Raise"
                app:icon="@drawable/ic_raise" />

            <Button
                android:id="@+id/btnDown"
                style="@style/PadIconButton"
                android:contentDescription="Lower"
                app:icon="@drawable/ic_lower" />

            <View
                android:layout_width="28dp"
                android:layout_height="1dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="2dp"
                android:background="@color/glass_stroke" />

            <Button
                android:id="@+id/btnRotL"
                style="@style/PadIconButton"
                android:contentDescription="Rotate left"
                app:icon="@drawable/ic_rotate_left" />

            <Button
                android:id="@+id/btnRotR"
                style="@style/PadIconButton"
                android:contentDescription="Rotate right"
                app:icon="@drawable/ic_rotate_right" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
