<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Always dark: it's a camera tool, and footage reads best on black. -->
    <style name="Theme.PocketTrack" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_container</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="colorOnSecondary">@color/bg</item>
        <item name="colorSecondaryContainer">@color/surface_high</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/bg</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_high</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.PocketTrack.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
    </style>

    <!-- Round frosted icon button over the camera image. -->
    <style name="GlassIconButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="cornerRadius">22dp</item>
        <item name="backgroundTint">@color/glass</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">@android:color/white</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- On/off icon toggle: orange when on. -->
    <style name="ToggleIconButton" parent="GlassIconButton">
        <item name="android:checkable">true</item>
        <item name="backgroundTint">@color/toggle_bg</item>
        <item name="iconTint">@color/toggle_fg</item>
        <item name="iconSize">20dp</item>
        <item name="strokeColor">@color/toggle_stroke</item>
    </style>

    <!-- Borderless icon button that sits on the D-pad / side pill. -->
    <style name="PadIconButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">26dp</item>
        <item name="iconTint">@android:color/white</item>
        <item name="rippleColor">#40FFFFFF</item>
    </style>

    <!-- Frosted pill with icon + label. -->
    <style name="GlassChip" parent="Widget.Material3.Button">
        <item name="android:layout_width">128dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">@color/glass</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@android:color/white</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="ToggleChip" parent="GlassChip">
        <item name="android:checkable">true</item>
        <item name="backgroundTint">@color/toggle_bg</item>
        <item name="iconTint">@color/toggle_fg</item>
        <item name="android:textColor">@color/toggle_fg</item>
        <item name="strokeColor">@color/toggle_stroke</item>
    </style>

    <!-- Status text over the camera image. -->
    <style name="GlassPillText">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
