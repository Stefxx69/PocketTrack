    <item><shape android:shape="oval"><solid android:color="#66000000" /></shape></item>
    <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#FFFFFFFF" /></shape></item>
    <item android:bottom="9dp" android:left="9dp" android:right="9dp" android:top="9dp">
        <shape android:shape="oval"><solid android:color="@color/rec_red" /></shape>
    </item>
</layer-list>
